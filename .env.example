# ---------- Supabase (Project Settings → API) ----------
# Public values — safe in the browser (RLS protects your data).
NEXT_PUBLIC_SUPABASE_URL=
# The anon key, or the newer "publishable" key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never expose. Used by the push dispatcher (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Web Push (generate: npx web-push generate-vapid-keys) ----------
VAPID_PUBLIC_KEY=
# SERVER ONLY
VAPID_PRIVATE_KEY=
# mailto: or https: contact for push services
VAPID_SUBJECT=mailto:you@example.com

# ---------- Scheduler ----------
# SERVER ONLY. Random string (e.g. `openssl rand -hex 32`); the scheduler sends it as a Bearer token.
CRON_SECRET=
